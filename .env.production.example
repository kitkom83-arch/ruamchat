NODE_ENV=production

# ใส่โดเมนจริงที่ชี้ A record มาที่ VPS แล้ว เช่น chat.example.com
APP_DOMAIN=chat.example.com
APP_URL=https://chat.example.com
API_URL=https://chat.example.com/api
NEXT_PUBLIC_API_URL=/api

# Database ภายใน Docker network
POSTGRES_USER=aiomni
POSTGRES_PASSWORD=change-this-long-random-password
POSTGRES_DB=aiomni
DATABASE_URL=postgresql://aiomni:change-this-long-random-password@postgres:5432/aiomni?schema=public

# Redis ภายใน Docker network
REDIS_URL=redis://redis:6379

# MinIO/S3-compatible storage ภายใน Docker network
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=change-this-minio-user
S3_SECRET_KEY=change-this-long-minio-password
S3_BUCKET=omni-chat

# สร้างใหม่ก่อนขึ้น production: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-base64-32-byte-key
JWT_SECRET=replace-with-long-random-jwt-secret

# OpenAI ใส่เมื่อพร้อมใช้ AI จริง ถ้าเว้นว่าง ระบบยังมี fallback draft สำหรับทดสอบ
OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=gpt-5.4-mini
OPENAI_REPLY_MODEL=gpt-5.5
OPENAI_VECTOR_STORE_ID=
