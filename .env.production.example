NODE_ENV=production
API_MODE=api
DATA_MODE=api

# ใส่โดเมนจริงที่ชี้ A record มาที่ VPS แล้ว เช่น chat.example.com
APP_DOMAIN=chat.example.com
APP_URL=https://chat.example.com
API_URL=https://chat.example.com/api
NEXT_PUBLIC_DATA_MODE=api
NEXT_PUBLIC_API_BASE_URL=/api

# Database ภายใน Docker network
POSTGRES_USER=aiomni
POSTGRES_PASSWORD=change-this-long-random-password
POSTGRES_DB=aiomni
DATABASE_URL=postgresql://aiomni:change-this-long-random-password@postgres:5432/aiomni?schema=public

# Redis ภายใน Docker network
REDIS_URL=redis://redis:6379

# MinIO/S3-compatible storage ภายใน Docker network
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=change-this-minio-user
S3_SECRET_KEY=change-this-long-minio-password
S3_BUCKET=omni-chat

# สร้างใหม่ก่อนขึ้น production: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-base64-32-byte-key
JWT_SECRET=replace-with-long-random-jwt-secret

# Sprint 54 pilot mode: keep AI local/mock and provider outbound disabled.
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_CLASSIFIER_MODEL=gpt-5.4-mini
OPENAI_REPLY_MODEL=gpt-5.5
OPENAI_VECTOR_STORE_ID=

# Provider readiness only. Do not enable real outbound during Sprint 54.
PROVIDER_OUTBOUND_MODE=disabled
PROVIDER_OUTBOUND_ENABLED=false
PROVIDER_SANDBOX_MODE=disabled
PROVIDER_SANDBOX_ALLOWLIST=
CHANNEL_MODE=mock
META_CHANNEL_MODE=mock
LINE_SANDBOX_ALLOWLIST=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
TELEGRAM_SANDBOX_ALLOWLIST=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
META_VERIFY_TOKEN=
FACEBOOK_VERIFY_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
META_APP_SECRET=
FACEBOOK_SANDBOX_ALLOWLIST=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_SANDBOX_ALLOWLIST=
INSTAGRAM_ACCESS_TOKEN=

# =============================================================================
# GO-LIVE TOGGLES (เปิด outbound จริง + AI จริง)
# -----------------------------------------------------------------------------
# ⚠️ ห้าม commit secret จริง — เว้นค่าว่างในไฟล์ .example นี้ แล้วใส่ค่าจริงเฉพาะ
#    ในไฟล์ env ของเซิร์ฟเวอร์ (นอก git). ห้าม echo/log token.
#
# ขั้นตอนเปิดใช้งานจริง (แนะนำเริ่มที่ sandbox + allowlist ก่อน):
#   AI_MODE=real
#   OPENAI_API_KEY=            # << ใส่ค่าจริงนอก git
#   OPENAI_ALLOW_REAL_CALLS=true
#   PROVIDER_OUTBOUND_ENABLED=true
#   PROVIDER_OUTBOUND_MODE=sandbox     # -> เปลี่ยนเป็น real เมื่อพร้อม
#   PROVIDER_SANDBOX_MODE=enabled
#   CHANNEL_MODE=sandbox               # Meta ใช้ META_CHANNEL_MODE
#   LINE_SANDBOX_ALLOWLIST=            # lineUserId ที่อนุญาต (คั่นด้วย ,)
#   TELEGRAM_SANDBOX_ALLOWLIST=        # telegram chatId ที่อนุญาต
#
# เก็บ channel access token แบบเข้ารหัส (ไม่ commit ค่า):
#   printf '%s' "<TOKEN>" | node scripts/set-channel-token.mjs --channel-account-id=<id>
#   (สคริปต์เข้ารหัส AES-256-GCM ด้วย APP_ENCRYPTION_KEY -> accessTokenCiphertext)
# =============================================================================
# OPENAI_ALLOW_REAL_CALLS=false
