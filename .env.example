NODE_ENV=development
API_MODE=local
DATA_MODE=mock
APP_URL=http://localhost:3012
API_URL=http://localhost:4000
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/aiomni?schema=public
REDIS_URL=redis://127.0.0.1:56379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=omni-chat
APP_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
JWT_SECRET=dev-local-jwt-secret
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_MODE=mock
# Azure AI Foundry v1 (ใส่เมื่อใช้ Azure แทน api.openai.com): ตั้ง OPENAI_BASE_URL
# ให้ไม่ว่าง แล้วโค้ดจะ route ผ่าน base URL นี้ด้วย OpenAI client ปกติ (responses.create).
# OPENAI_API_KEY = Azure key, OPENAI_MODEL = ชื่อ deployment (เช่น gpt-5.4)
# ตัวอย่าง: https://<resource>.services.ai.azure.com/openai/v1/
OPENAI_BASE_URL=
OPENAI_CLASSIFIER_MODEL=gpt-5.4-mini
OPENAI_REPLY_MODEL=gpt-5.5
OPENAI_VECTOR_STORE_ID=
PROVIDER_OUTBOUND_MODE=disabled
PROVIDER_OUTBOUND_ENABLED=false
PROVIDER_SANDBOX_MODE=disabled
PROVIDER_SANDBOX_ALLOWLIST=
CHANNEL_MODE=mock
LINE_SANDBOX_ALLOWLIST=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
TELEGRAM_SANDBOX_ALLOWLIST=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
META_CHANNEL_MODE=mock
META_VERIFY_TOKEN=
FACEBOOK_VERIFY_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
META_APP_SECRET=
FACEBOOK_SANDBOX_ALLOWLIST=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_SANDBOX_ALLOWLIST=
INSTAGRAM_ACCESS_TOKEN=

# =============================================================================
# GO-LIVE (outbound จริง + AI จริง) — คู่มือย่อ
# -----------------------------------------------------------------------------
# ⚠️ SECRET ทั้งหมดต้องอยู่ "นอก git": ใส่ค่าจริงในไฟล์ .env ในเครื่อง/เซิร์ฟเวอร์
#    เท่านั้น อย่า commit ค่าเหล่านี้ลง repo (ไฟล์ .example นี้ต้องเว้นว่างไว้).
#    ห้าม echo/log token จริง.
#
# 1) เปิด AI จริง (worker + api):
#      AI_MODE=real                 # worker: ไม่ใช่ mock -> เรียก OpenAI จริง
#      OPENAI_API_KEY=<sk-...>      # << secret นอก git
#      OPENAI_ALLOW_REAL_CALLS=true # api orchestrator อนุญาต real call
#
# 2) เปิด outbound จริงไป provider (LINE/Telegram/Meta):
#      PROVIDER_OUTBOUND_ENABLED=true
#      PROVIDER_OUTBOUND_MODE=sandbox   # sandbox (แนะนำตอนทดสอบ) หรือ real
#      PROVIDER_SANDBOX_MODE=enabled
#      CHANNEL_MODE=sandbox             # หรือ real (Meta ใช้ META_CHANNEL_MODE)
#      LINE_SANDBOX_ALLOWLIST=<lineUserId ที่อนุญาต>      # กันยิงมั่ว
#      TELEGRAM_SANDBOX_ALLOWLIST=<telegram chatId ที่อนุญาต>
#    guard จะปล่อยส่งจริงเฉพาะ recipient ที่อยู่ใน allowlist และ tenant ตรงกัน.
#
# 3) Secret ที่ต้องใส่นอก git:
#      APP_ENCRYPTION_KEY  = openssl rand -base64 32  (32-byte base64)
#      OPENAI_API_KEY, LINE_CHANNEL_SECRET, LINE_CHANNEL_ACCESS_TOKEN,
#      TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, META_APP_SECRET, ...
#
# 4) เก็บ channel access token แบบเข้ารหัสลง DB (ไม่ commit ค่า):
#      "<PASTE_TOKEN>" | node scripts/set-channel-token.mjs --channel-account-id=<id>
#    สคริปต์อ่าน token จาก STDIN/env เท่านั้น, เข้ารหัส AES-256-GCM ด้วย
#    APP_ENCRYPTION_KEY แล้ว update ChannelAccount.accessTokenCiphertext.
# =============================================================================
# OPENAI_ALLOW_REAL_CALLS=false
